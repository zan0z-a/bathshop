@model IEnumerable<Service>

@{
    ViewData["Title"] = "Управление услугами";
}

<section class="page-hero">
    <div class="container">
        <span class="eyebrow">АДМИН-ПАНЕЛЬ</span>
        <h1>Услуги</h1>
        <p><a asp-action="Index">← Вернуться в админ-панель</a></p>
    </div>
</section>

<section class="section">
    <div class="container admin-manage">
        <h2>Добавить услугу</h2>

        <form asp-action="SaveService" method="post" class="manage-form">
            <input type="hidden" name="Id" value="0" />
            <input name="Title" placeholder="Название" maxlength="100" required />
            <input name="ShortDescription" placeholder="Краткое описание" maxlength="250" required />
            <textarea name="Description" placeholder="Полное описание" maxlength="1500" required></textarea>
            <input name="PriceFrom" type="number" min="0" step="1" placeholder="Цена от" required />
            <button class="button button-dark" type="submit">Добавить</button>
        </form>

        <h2>Список услуг</h2>

        @foreach (var item in Model)
        {
            <div class="manage-item">
                <form asp-action="SaveService" method="post" class="manage-form">
                    <input type="hidden" name="Id" value="@item.Id" />
                    <input name="Title" value="@item.Title" required />
                    <input name="ShortDescription" value="@item.ShortDescription" required />
                    <textarea name="Description" required>@item.Description</textarea>
                    <input name="PriceFrom" type="number" min="0" step="1" value="@item.PriceFrom" required />
                    <button class="small-button" type="submit">Сохранить</button>
                </form>

                <form asp-action="DeleteService" method="post">
                    <input type="hidden" name="id" value="@item.Id" />
                    <button class="text-button danger" type="submit">Удалить</button>
                </form>
            </div>
        }
    </div>
</section>
