@model IEnumerable<PortfolioItem>

@{
    ViewData["Title"] = "Портфолио";
}

<section class="page-hero">
    <div class="container">
        <span class="eyebrow">ПОРТФОЛИО</span>
        <h1>Примеры наших работ</h1>
        <p>Посмотрите, как могут выглядеть обновлённые ванные комнаты.</p>
    </div>
</section>

<section class="section">
    <div class="container portfolio-grid portfolio-page">
        @foreach (var item in Model)
        {
            <article class="portfolio-card">
                <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                <div>
                    <span class="muted">@item.Year</span>
                    <h3>@item.Title</h3>
                    <p>@item.Description</p>
                </div>
            </article>
        }
    </div>
</section>
