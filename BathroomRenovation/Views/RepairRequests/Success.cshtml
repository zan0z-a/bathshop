@model RepairRequest

@{
    ViewData["Title"] = "Заявка отправлена";
}

<section class="section success-section">
    <div class="container success-card">
        <span class="success-mark">✓</span>
        <span class="eyebrow">ЗАЯВКА ОТПРАВЛЕНА</span>
        <h1>Спасибо, @Model.Name!</h1>
        <p>Мы получили вашу заявку и свяжемся с вами по номеру @Model.Phone.</p>
        <a class="button button-dark" asp-controller="Home" asp-action="Index">На главную</a>
    </div>
</section>
