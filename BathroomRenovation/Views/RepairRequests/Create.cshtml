@model RepairRequest

@{
    ViewData["Title"] = "Заявка на ремонт";
}

<section class="page-hero">
    <div class="container">
        <span class="eyebrow">ЗАЯВКА НА РЕМОНТ</span>
        <h1>Расскажите о вашей ванной</h1>
        <p>Коротко опишите задачу. Мы свяжемся с вами.</p>
    </div>
</section>

<section class="section">
    <div class="container form-layout">
        <div>
            <h2>Начнём с простого</h2>
            <p>Укажите удобный номер телефона. Остальные детали можно будет обсудить при звонке.</p>
            <div class="form-hint">Заявка бесплатная и ни к чему вас не обязывает.</div>
        </div>

        <div class="form-card">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="validation"></div>

                <div class="form-field">
                    <label asp-for="Name">Ваше имя</label>
                    <input asp-for="Name" placeholder="Как к вам обращаться" />
                    <span asp-validation-for="Name"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Phone">Телефон</label>
                    <input asp-for="Phone" placeholder="+7 (___) ___-__-__" />
                    <span asp-validation-for="Phone"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" placeholder="name@example.com" />
                    <span asp-validation-for="Email"></span>
                </div>

                <div class="form-field">
                    <label asp-for="ServiceId">Какая услуга нужна?</label>
                    <select asp-for="ServiceId" asp-items="ViewBag.Services">
                        <option value="">Пока не определился</option>
                    </select>
                </div>

                <div class="form-field">
                    <label asp-for="Description">Опишите задачу</label>
                    <textarea asp-for="Description" rows="4" placeholder="Что нужно отремонтировать или обновить?"></textarea>
                    <span asp-validation-for="Description"></span>
                </div>

                <button class="button button-dark button-wide" type="submit">Отправить заявку</button>
                <small>Нажимая кнопку, вы соглашаетесь на обработку указанных данных для связи с вами.</small>
            </form>
        </div>
    </div>
</section>
