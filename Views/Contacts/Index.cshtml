@{
    ViewData["Title"] = "Контакты";
}

<section class="page-hero">
    <div class="container">
        <span class="eyebrow">КОНТАКТЫ</span>
        <h1>Будем на связи</h1>
        <p>Ответим на вопросы и поможем спланировать ремонт.</p>
    </div>
</section>

<section class="section">
    <div class="container contacts-layout">
        <div class="contact-details">
            <div>
                <span class="eyebrow">ТЕЛЕФОН</span>
                <h2><a href="tel:+79524060691">8 (952) 406-06-91</a></h2>
            </div>
            <div>
                <span class="eyebrow">ПОЧТА</span>
                <h2><a href="#">bathstore@gmail.com</a></h2>
            </div>
            <div>
                <span class="eyebrow">АДРЕС</span>
                <h2>Ижевск</h2>
                <p>Ул. Пушкина, д. 123</p>
            </div>
            <a class="button button-dark" asp-controller="RepairRequests" asp-action="Create">Оставить заявку</a>
        </div>

        <div class="map-placeholder">
            <iframe
                title="Карта проезда по Ижевску"
                src="https://www.openstreetmap.org/export/embed.html?bbox=53.17%2C56.82%2C53.27%2C56.89&layer=mapnik&marker=56.852738%2C53.2114896"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen>
            </iframe>
        </div>
    </div>
</section>
